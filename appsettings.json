{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "API_Demo.Controllers.LoggerController": "Trace"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Your ConnectionStrings"
  },
  "ExternalLogin": {
    "Google": {
      "ClientId": "Your ClientId",
      "ClientSecret": "YourClientSecret "
    },
    "GitHub": {
      "ClientId": "Your ClientId",
      "ClientSecret": "Your ClientSecret"
    },
    "LinkedIn": {
      "ClientId": "Your ClientId",
      "ClientSecret": "Your ClientSecret"
    },
    "Microsoft": {
      "ClientId": "Your ClientId",
      "ClientSecret": "Your  ClientSecret"

    },
    "Facebook": {
      "AppId": "Your AppId",
      "AppSecret": "Your AppSecret"
    }
  },
  "JWT": {
    "Key": "Your Key",
    "Issuer": "https://localhost:7250/",
    "Audience": "https://localhost:4200/",
    "DurationInMinutes": 60
  },
  "Uploads": {
    "ImageSizeInMB": 5,
    "VideoSizeInMB": 50,
    "FileSizeInMB": 20,
    "UploadFolder": "Uploads",
    "ImageFolder": "Images",
    "VideoFolder": "Videos",
    "FileFolder": "Files",
    "ImageExtentionAllowed": [ ".jpg", ".png", ".jpeg" ],
    "FileExtentionAllowed": [ ".pdf", ".ppxt", ".docx" ],
    "VideoExtentionAllowed": [ ".mp4", ".webm" ]
  },
  "MailSetting": {
    "Email": "Your Email",
    "DisplayName": "Your Name",
    "Password": "Your Password",
    "Host": "smtp.gmail.com",
    "Port": 587
  },
  "Twilio": {
    "AccountSID": "Your AccountSID",
    "AuthToken": "Your AuthToken",
    "TwilioPhoneNumber": "+Your TwilioPhoneNumber"
  }
}